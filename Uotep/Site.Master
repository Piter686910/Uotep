<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="Uotep.SiteMaster" %>

<!DOCTYPE html>
<html lang="it">
<head runat="server">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - U.O.T.E.P.</title>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>
    <webopt:BundleReference runat="server" Path="~/Content/css" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />

    <style>
        body {
            padding-top: 70px;
            background-color: #f8f9fa;
        }

        /* Navbar con gradiente professionale */
        .navbar-custom {
    min-height: 65px;
    background-color: #337ab7 !important;
}

            .navbar-custom .navbar-nav > li > a {
                color: #ffffff !important;
                font-weight: 600; /* Rende il testo più leggibile */
                text-transform: uppercase;
                font-size: 1.3rem; /* Aumentato da 0.85rem a 1.1rem */
                letter-spacing: 0.8px; /* Spaziatura tra lettere migliorata */
                padding-top: 20px !important; /* Più spazio verticale */
                padding-bottom: 20px !important;
                padding-left: 15px !important;
                padding-right: 15px !important;
                transition: 0.3s;
            }

                .navbar-custom .navbar-nav > li > a:hover {
                    background: rgba(255,255,255,0.1) !important;
                }

        /* Sottomenu a comparsa laterale */
        .dropdown-submenu {
            position: relative;
        }

            .dropdown-submenu > .dropdown-menu {
                top: 0;
                left: 100%;
                margin-top: -1px;
                border-radius: 4px;
            }
        /* Ingrandimento voci dei sottomenu (dropdown) */
        .dropdown-menu > li > a {
            font-size: 1.4rem; /* Ingrandito anche il testo del dropdown */
            padding: 10px 20px; /* Più spazio per il click/tap */
            font-weight: 500;
        }
        /* Ingrandimento sottomenu laterali */
.dropdown-submenu > a {
    font-size: 1.4rem !important;
}
        .dropdown-submenu:hover > .dropdown-menu {
            display: block;
            background-color:yellow;
        }

        .dropdown-submenu > a:after {
            content: "\25B6";
            float: right;
            margin-left: 10px;
            font-size: 0.7em;
            opacity: 0.7;
        }

        /* Watermark Logo */
        .sfondo-personalizzato {
            position: relative;
            min-height: 95vh;
        }

            .sfondo-personalizzato::before {
                content: "";
                position: fixed;
                top: 55%;
                left: 50%;
                transform: translate(-50%, -50%);
                width: 50%;
                height: 50%;
                background-image: url('<%= ResolveUrl("~/FileComuni/Logo2.jpeg") %>');
                background-repeat: no-repeat;
                background-position: center;
                background-size: contain;
                opacity: 0.04;
                z-index: -1;
                pointer-events: none;
            }

        .user-log-pill {
            background: rgba(255,255,255,0.15);
            color: white;
            padding: 5px 15px;
            border-radius: 20px;
            margin-top: 10px;
            font-size: 0.85rem;
        }

        #wordViewerFrame {
            width: 100%;
            height: 750px;
            border: 1px solid #ddd;
            border-radius: 8px;
        }
        /* Log Utente più visibile */
.user-log-pill {
    background: rgba(255,255,255,0.2);
    color: white;
    padding: 8px 18px;
    border-radius: 20px;
    margin-top: 12px;
    font-size: 1rem;            /* Ingrandito nome utente */
    font-weight: bold;
}
    </style>
</head>
<body>
    <form runat="server">
        <asp:ScriptManager runat="server">
            <Scripts>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Path="~/Scripts/jquery-3.7.1.js" />
                <asp:ScriptReference Name="bootstrap" />
                <asp:ScriptReference Path="~/Scripts/bootstrap.bundle.min.js" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
            </Scripts>
        </asp:ScriptManager>

        <nav class="navbar navbar-inverse navbar-fixed-top navbar-custom">
            <div class="container-fluid">
                <div class="navbar-header">
                    <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                        <span class="icon-bar"></span><span class="icon-bar"></span><span class="icon-bar"></span>
                    </button>
                    <a class="navbar-brand nav-link active" href="~/View/Default.aspx" runat="server" style="color: white !important; font-weight: bold;">U.O.T.E.P. System</a>
                </div>

                <div class="navbar-collapse collapse">
                    <ul class="nav navbar-nav">

                        <li id="menuAmministratore" runat="server" visible="false" class="dropdown">
                            <a href="#" class="dropdown-toggle nav-link active" data-toggle="dropdown">Dashboard <span class="caret"></span></a>
                            <ul class="dropdown-menu">
                                <li><a id="menuAttivita" runat="server" visible="false" href="~/View/Attivita">Attività</a></li>
                                <li><a id="Amministratore" runat="server" visible="false"  href="~/View/Dashboard">Dashboard</a></li>
                                <li><a id="SchedaCarburante" runat="server" visible="false" href="~/View/GestioneAuto">Scheda Carburante</a></li>
                                <li><a id="Turnazione" runat="server" visible="false" href="~/View/Turnazione">Turnazione</a></li>
                            </ul>
                        </li>

                        <li><a id="Attivita" runat="server" visible="false" href="~/View/Attivita">Attività</a></li>

                        <li id="menuArchivio" runat="server" visible="false" class="dropdown">
                            <a href="#" class="dropdown-toggle" data-toggle="dropdown">Archivio <span class="caret"></span></a>
                            <ul class="dropdown-menu">
                                <li id="subMenuUOTE" runat="server" visible="false" class="dropdown-submenu">
                                    <a href="#">Archivio UOTE</a>
                                    <ul class="dropdown-menu">
                                        <li><a id="InserimentoArchivioUote" runat="server" visible="false" href="~/View/InserimentoArchivio">Inserimento Pratica</a></li>
                                        <li><a id="RicercaArchivioUote" runat="server" visible="false" href="~/View/RicercaArchivio">Ricerca Pratica</a></li>
                                    </ul>
                                </li>
                                <li id="subMenuUOTP" runat="server" visible="false" class="dropdown-submenu">
                                    <a href="#">Archivio UOTP</a>
                                    <ul class="dropdown-menu">
                                        <li><a id="InserimentoArchivioUotp" runat="server" visible="false" href="~/View/Uotp/InserimentoArchivioUotp">Inserimento Pratica TP</a></li>
                                        <li><a id="RicercaArchivioUotp" runat="server" visible="false" href="~/View/Uotp/RicercaArchivioUotp">Ricerca Pratica TP</a></li>
                                    </ul>
                                </li>
                                <li class="divider"></li>
                                <li><a id="GestionePraticaUote" runat="server" visible="false" href="~/View/GestionePratica">Gestione Pratica</a></li>
                                <li><a id="StatisticheAtti" runat="server" visible="false" href="~/View/StatisticheAtti">Statistiche</a></li>
                            </ul>
                        </li>

                        <li id="menuCoordinamentoAtti" runat="server" visible="false" class="dropdown">
                            <a href="#" class="dropdown-toggle" data-toggle="dropdown">Coordinamento Atti <span class="caret"></span></a>
                            <ul class="dropdown-menu">
                                <li><a id="InserimentoAtti" runat="server" visible="false" href="~/View/Inserimento">Inserimento Atti</a></li>
                                <li><a id="RicercaAtti" runat="server" visible="false" href="~/View/Visualizza">Ricerca Atti</a></li>
                            </ul>
                        </li>

                        <li id="menuAccertatori" runat="server" visible="false" class="dropdown">
                            <a href="#" class="dropdown-toggle" data-toggle="dropdown">Scheda Intervento <span class="caret"></span></a>
                            <ul class="dropdown-menu">
                                <li><a id="Decretazione" runat="server" visible="false" href="~/View/Modifica">Decretazione</a></li>
                                <li><a id="menuNuovaScheda" runat="server" visible="false" href="~/View/SchedaIntervento">Nuova Scheda</a></li>
                                <li><a id="menuRicercaScheda" runat="server" visible="false" href="~/View/RicercaScheda">Ricerca Scheda</a></li>
                                <li><a id="mnGestioneAuto" runat="server" visible="false" href="~/View/GestioneAuto">Scheda Carburante</a></li>
                                <li><a id="EstraiStatistiche" runat="server" visible="false" href="~/View/EstraiStatistiche">Statistiche</a></li>
                            </ul>
                        </li>

                        <li id="menuFureria" runat="server" visible="false" class="dropdown">
                            <a href="#" class="dropdown-toggle" data-toggle="dropdown">Fureria <span class="caret"></span></a>
                            <ul class="dropdown-menu">
                                <li><a id="FSchedaDipendente" runat="server" visible="false" href="~/View/SchedaDipendente">Scheda Dipendente</a></li>
                                <li><a id="AccTrunoMensile" runat="server" visible="false" href="~/View/Turnazione">Turnazione Mensile Acc.</a></li>
                                <li><a id="TurnoMensile" runat="server" visible="false" href="~/View/Turnazione">Turnazione Mensile</a></li>
                            </ul>
                        </li>

                        <li id="menuSegreteria" runat="server" visible="false" class="dropdown">
                            <a href="#" class="dropdown-toggle" data-toggle="dropdown">Ufficio PG <span class="caret"></span></a>
                            <ul class="dropdown-menu">
                                <li><a id="StatistichePg" runat="server" visible="false" href="~/View/StatistichePg">Statistiche</a></li>
                                <li><a id="PG" runat="server" visible="false" href="~/View/Segreteria">Ufficio PG</a></li>
                            </ul>
                        </li>

                        <li id="menuManTabelle" runat="server" visible="false"><a href="~/View/ManutenzioneTabelle" runat="server">Tabelle</a></li>
                        <li><a id="Urp" runat="server" visible="false" href="~/View/Urp">Urp</a></li>

                        <li>
                            <asp:HyperLink ID="helpLink" runat="server" NavigateUrl="~/FileComuni/Manualeutenteuotep.pdf" Target="_blank">Manuale</asp:HyperLink>
                        </li>

                        <li id="menuEsci" runat="server" visible="false">
                            <asp:LinkButton ID="lnkLogout" runat="server" OnClick="Esci_Click" CssClass="text-danger fw-bold">ESCI</asp:LinkButton>
                        </li>
                    </ul>

                    <ul class="nav navbar-nav navbar-right" style="margin-right: 15px;">
                        <li id="userLog" runat="server" visible="false">
                            <div class="user-log-pill">
                                <span class="fa-solid fa-user"></span>&nbsp;
                                <asp:Label ID="lblUser" runat="server" />
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <div class="container body-content sfondo-personalizzato">
            <div id="viewerContainer" style="display: none; margin-bottom: 20px;">
                <iframe id="wordViewerFrame" src=""></iframe>
            </div>

            <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>

            <footer class="text-center" style="margin-top: 40px; padding: 20px; border-top: 1px solid #eee;">
                <asp:Label ID="lblMsg" runat="server" CssClass="label label-danger" Style="display: block; margin-bottom: 10px;"></asp:Label>
                <p>&copy; <%: DateTime.Now.Year %> - <strong>U.O.T.E.P.</strong> | Powered by P.A.</p>
            </footer>
        </div>

        <div class="modal fade" id="SiteModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div id="modalHeaderColor" runat="server" class="modal-header">
                        <h4 class="modal-title">
                            <asp:Label ID="lblModalTitolo" runat="server" Text="Avviso" /></h4>
                    </div>
                    <div class="modal-body text-center">
                        <p id="TxtMessage" runat="server" class="lead"></p>
                    </div>
                    <div class="modal-footer">
                        <asp:Button ID="btChiudiPopUp" runat="server" CssClass="btn btn-default" Text="Chiudi" OnClick="btChiudiPopUp_Click" />
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="ModalConferma" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header bg-warning">
                        <h4 class="modal-title">
                            <asp:Label ID="lblTitoloConferma" runat="server" Text="Conferma" /></h4>
                    </div>
                    <div class="modal-body">
                        <asp:Label ID="lblTestoConferma" runat="server" Text="Procedere con l'operazione?" />
                        <input type="hidden" id="hdnUrlDestinazione" />
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-default" data-dismiss="modal">Annulla</button>
                        <button type="button" class="btn btn-primary" onclick="EseguiRedirect()">Prosegui</button>
                    </div>
                </div>
            </div>
        </div>

        <script type="text/javascript">
            function ApriModalConferma(titolo, messaggio, url) {
                $('#hdnUrlDestinazione').val(url);
                $('#ModalConferma').modal('show');
            }
            function EseguiRedirect() {
                var url = $('#hdnUrlDestinazione').val();
                if (url) { window.location.href = url; }
            }
        </script>
        <asp:HiddenField ID="hfMasterParam" runat="server" ClientIDMode="Static" />
    </form>
     <script src='<%= ResolveUrl("~/Scripts/Utility.js") %>'>

     </script>

</body>
</html>
